# 后端环境变量示例（方案 §9.8 密钥分离）
# 复制为 backend/.env 并填真实值；.env 绝不提交

# 数据库（psycopg2 驱动，方案 §4.7）
FINANCE_KNOWLEDGE_DATABASE_URL=postgresql+psycopg2://fk:fk@localhost:5432/financial_knowledge

# 三密钥职责分离（生产必须改为高熵随机值）
FINANCE_KNOWLEDGE_SESSION_SECRET=change-me-session
FINANCE_KNOWLEDGE_BYOK_MASTER_KEY=change-me-byok-master
# LangGraph checkpoint 加密：16/24/32 字节 AES key 的 base64；空则不加密（仅开发）
FINANCE_KNOWLEDGE_LANGGRAPH_AES_KEY=

# 首启初始化超管
FINANCE_KNOWLEDGE_SUPERADMIN_USERNAME=admin
FINANCE_KNOWLEDGE_SUPERADMIN_PASSWORD=change-me

# 报告导入 token（代表超管身份）
FINANCE_KNOWLEDGE_IMPORT_TOKEN=change-me-import

# 部署/安全
FINANCE_KNOWLEDGE_COOKIE_SECURE=false
FINANCE_KNOWLEDGE_ALLOW_INSECURE_HOST=false
FINANCE_KNOWLEDGE_ALLOWED_ORIGINS=["http://localhost:5173"]
FINANCE_KNOWLEDGE_ENVIRONMENT=development

# 注意：无全局 LLM_API_KEY —— 改 BYOK，各用户在设置页配置自己的 key
