# Financial Knowledge / Docker Compose 环境变量模板

# PostgreSQL
POSTGRES_PASSWORD=replace-with-a-long-random-password

# 三类密钥职责分离；生产必须使用独立高熵值
FINANCE_KNOWLEDGE_SESSION_SECRET=replace-with-a-long-random-session-secret
FINANCE_KNOWLEDGE_BYOK_MASTER_KEY=replace-with-a-long-random-byok-master-key
# 16/24/32 字节 AES key 的 base64；生产辩论 checkpoint 必填
FINANCE_KNOWLEDGE_LANGGRAPH_AES_KEY=replace-with-base64-aes-key

# 首次启动创建超管；后续启动幂等
FINANCE_KNOWLEDGE_SUPERADMIN_USERNAME=admin
FINANCE_KNOWLEDGE_SUPERADMIN_PASSWORD=replace-with-a-strong-password

# Codex/脚本显式导入报告时使用，代表超管身份
FINANCE_KNOWLEDGE_IMPORT_TOKEN=replace-with-another-long-random-token

# 自定义 OpenAI-compatible 服务 host 白名单，逗号分隔；API key/URL/模型在设置页按用户加密保存
FINANCE_KNOWLEDGE_LLM_ALLOWED_HOSTS=

# Caddy 自动 TLS 域名；本地 Compose 可用 localhost
FK_DOMAIN=your-domain.example

# 可选数据源
FINANCE_KNOWLEDGE_DATA_SOURCE_URLS=
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-with-feishu-app-secret
FEISHU_SIGNAL_WIKI_URL=https://your-domain.feishu.cn/wiki/your_wiki_token
